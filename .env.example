PORT=8080
NODE_ENV=development
LOG_LEVEL=info
META_VERIFY_TOKEN=replace-with-webhook-verify-token
META_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
WHATSAPP_API_VERSION=v23.0
WHATSAPP_REQUEST_TIMEOUT_MS=15000
WHATSAPP_MEDIA_SUPPORTED=false
WHATSAPP_TYPING_REFRESH_MS=20000
WHATSAPP_TYPING_MAX_MS=300000
QUEUE_PROVIDER=redis
QUEUE_CONSUMER_GROUP=eitri-whatsapp-gateway
QUEUE_LEASE_MS=60000
QUEUE_MAX_ATTEMPTS=5
QUEUE_DEDUP_SECONDS=86400
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_PREFIX=eitri:queue
QUEUE_POSTGRES_URL=
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=EITRI_WHATSAPP_EVENTS
QUEUE_TOPIC_INCOMING_TEXT=whatsapp.incoming.text
QUEUE_TOPIC_INCOMING_IMAGE=whatsapp.incoming.media.image
QUEUE_TOPIC_INCOMING_VIDEO=whatsapp.incoming.media.video
QUEUE_TOPIC_INCOMING_AUDIO=whatsapp.incoming.media.audio
QUEUE_TOPIC_INCOMING_DOCUMENT=whatsapp.incoming.media.document
QUEUE_TOPIC_OUTGOING=whatsapp.outgoing
AGENT_WORKER_ENABLED=true
AGENT_BACKEND_URL=http://127.0.0.1:8000
EITRI_GATEWAY_KEY=local-development-key-change-this-before-use
